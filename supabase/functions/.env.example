# Secrets for StudySprint's Supabase Edge Functions (Stripe + AI). These are NOT Vite env vars —
# they never reach the browser. For local `supabase functions serve`, copy this file to
# `supabase/functions/.env` (gitignored) and fill in real values, then run:
#   supabase functions serve --env-file supabase/functions/.env
# For a deployed project, set them with the CLI instead — see the Stripe setup docs:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...

# Anthropic (already required by the existing AI Organizer / Analyzer / Quiz / Syllabus functions)
ANTHROPIC_API_KEY=sk-ant-your-key

# Stripe — use TEST MODE keys (sk_test_... / whsec_...) for local development and staging.
# Switch to live keys (sk_live_..., a live webhook signing secret, and a live price id) only when
# you're ready to accept real payments — nothing else about the integration changes.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID_PRO=price_your_pro_monthly_price_id

# Public URL of the deployed StudySprint app (no trailing slash) — used to build the Stripe
# Checkout success/cancel URLs and the Billing Portal return URL. For local dev this can be left
# unset; the functions fall back to the request's Origin header (e.g. http://localhost:5173).
APP_URL=https://your-studysprint-domain.example

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase into every
# deployed Edge Function — do not set them here.
