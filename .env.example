# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# StudySprint Pro billing runs entirely through Supabase Edge Functions, never through the
# frontend, so there is no Stripe key of any kind here — the Stripe secret key, webhook signing
# secret, and price id live in supabase/functions/.env.example instead (set via
# `supabase secrets set` for a deployed project). See supabase/STRIPE_SETUP.md for the full guide.
